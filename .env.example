# Exemplo sem credenciais. O Python lê variáveis do ambiente do processo.
# Para Docker Compose, copie para .env e preencha somente na sua máquina.
OPENAI_API_KEY=
CONSULTA_PUBLIC_MODE=0
CONSULTA_REQUIRE_AI=0
CONSULTA_DAILY_LIMIT=100
CONSULTA_IP_HOURLY_LIMIT=40
